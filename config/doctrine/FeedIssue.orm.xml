<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusAgenticFeedsPlugin\Entity\FeedIssue" table="tmonier_agentic_feed_issue">
        <indexes>
            <index name="idx_tmonier_agentic_feed_issue_severity" columns="feed_id,severity" />
        </indexes>
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="severity" column="severity" type="string" length="8" />
        <field name="code" column="code" type="string" length="64" />
        <field name="field" column="field" type="string" length="64" nullable="true" />
        <field name="itemId" column="item_id" type="string" length="255" nullable="true" />
        <field name="productCode" column="product_code" type="string" length="255" nullable="true" />
        <field name="parameters" column="parameters" type="json" />
        <field name="createdAt" column="created_at" type="datetime" />

        <many-to-one field="feed" target-entity="Tmonier\SyliusAgenticFeedsPlugin\Entity\ProductFeedInterface">
            <join-column name="feed_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
